# Copy the values into your environment; this file is not loaded implicitly.
# Development: python backend/manage.py runserver 127.0.0.1:8000
LIKHA_ENV=production
LIKHA_DOMAIN=
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
LIKHA_ORIGIN=
LIKHA_DATA_DIR=/data
LIKHA_STATIC_ROOT=/app/staticfiles
LIKHA_TRUST_PROXY=1
LIKHA_PROXY_MODE=single
LIKHA_HEALTH_TOKEN=
LIKHA_PRIVACY_CONTACT=
LIKHA_PRIVACY_APPROVED=0
# Offline works without internet. Online additionally uses the HIBP hash-range API.
LIKHA_PASSWORD_BREACH_MODE=offline
# Supabase: use the session pooler PostgreSQL URI (port 5432), URL-encode password.
# Empty DATABASE_URL retains SQLite for local development only.
DATABASE_URL=
LIKHA_MEDIA_BACKEND=local
SUPABASE_URL=
# Server-only legacy service_role JWT from Supabase. Never publish in frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=likha-private
